<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#070814"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Виджет задач"
        android:textColor="#EEF2FF"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Какой срок показывать на рабочем столе?"
        android:textColor="#93A0C4"
        android:textSize="14sp" />

    <RadioGroup
        android:id="@+id/range_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp">

        <RadioButton
            android:id="@+id/range_day"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:padding="12dp"
            android:text="День — задачи на сегодня"
            android:textColor="#EEF2FF" />

        <RadioButton
            android:id="@+id/range_week"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:text="Неделя — с понедельника"
            android:textColor="#EEF2FF" />

        <RadioButton
            android:id="@+id/range_month"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:text="Месяц — текущий месяц"
            android:textColor="#EEF2FF" />
    </RadioGroup>

    <Button
        android:id="@+id/btn_add"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:backgroundTint="#7EE7FF"
        android:text="Добавить виджет"
        android:textColor="#070814" />
</LinearLayout>
