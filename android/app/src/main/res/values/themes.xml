<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.VoidPrism" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">#070814</item>
        <item name="android:windowBackground">#070814</item>
        <item name="android:colorPrimary">#7EE7FF</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="WidgetDayHead">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">#6D789C</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="WidgetWeekRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <style name="WidgetDayCell">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">26dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">#D7DEF8</item>
        <item name="android:textSize">11sp</item>
    </style>

    <style name="WidgetTaskLine">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">2</item>
        <item name="android:textColor">#EEF2FF</item>
        <item name="android:textSize">12sp</item>
        <item name="android:visibility">gone</item>
    </style>
</resources>
